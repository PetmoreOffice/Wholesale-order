# Production on the Windows server; use the existing read-only SQL login.
NODE_ENV=production
HOST=127.0.0.1
PORT=3005
CLIENT_ORIGIN=https://order.example.com
DB_DIALECT=mssql
DB_HOST=your-internal-sql-server
DB_PORT=1433
DB_NAME=your-database
DB_USER=your-read-only-user
DB_PASSWORD=replace-locally
# Match your SQL Server TLS configuration.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/apps/Wholesale-order/api/secrets/firebase-service-account.json
ORDER_ARCHIVE_DAYS=365
