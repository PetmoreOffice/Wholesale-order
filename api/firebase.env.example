# Firebase service-account values. Keep the real values only in api/.env.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Recommended: keep the downloaded service-account JSON outside Git.
GOOGLE_APPLICATION_CREDENTIALS=C:\secure-path\firebase-service-account.json

# Alternative: store the service-account fields directly in api/.env.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-with-service-account-private-key\\n-----END PRIVATE KEY-----\\n"
